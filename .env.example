APP_NAME="Leonilda Bob | Bob Advogados"
APP_BASE_URL="http://127.0.0.1:8000"
LEONILDA_DB_PATH="data/leonilda.sqlite"

# Painel interno (/admin). Em produção, use senha forte e chave longa.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""
ADMIN_PASSWORD_HASH=""
ADMIN_SESSION_SECRET=""
ADMIN_SESSION_TTL_SECONDS="28800"

# WhatsApp oficial. Enquanto WHATSAPP_DRY_RUN=1, o painel registra sem enviar mensagens reais.
WHATSAPP_PROVIDER="official"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_FIRST_CONTACT_TEMPLATE=""
WHATSAPP_TEMPLATE_LANGUAGE="pt_BR"
WHATSAPP_AUTO_REPLY="1"

# Alternativa local por QR. Espera POST /send com JSON {"to": "5511999999999", "text": "..."}.
WHATSAPP_QR_BRIDGE_URL="http://127.0.0.1:3333"
WHATSAPP_DRY_RUN="1"
META_GRAPH_VERSION="v19.0"

# Used to hash visitor IPs for metrics without storing raw IP.
METRICS_SALT="change-me-local"

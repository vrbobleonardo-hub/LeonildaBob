APP_NAME="Leonilda Bob | Bob Advogados"
APP_ENV="development"
APP_BASE_URL="http://127.0.0.1:8000"
ALLOWED_HOSTS="127.0.0.1,localhost,testserver"
COOKIE_SECURE="0"
DOCS_ENABLED="1"
LEONILDA_DB_PATH="data/leonilda.sqlite"
PRIVATE_UPLOAD_DIR="data/uploads/whatsapp"
MAX_UPLOAD_BYTES="26214400"
REQUIRE_VIRUS_SCAN="0"
DATABASE_URL=""
DB_POOL_MIN_SIZE="0"
DB_POOL_MAX_SIZE="5"
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""
SUPABASE_STORAGE_BUCKET="whatsapp-media"
CONTACT_PHONE_DISPLAY="(11) 99492-6810"
CONTACT_PHONE_DIGITS="5511994926810"
CONTACT_EMAIL=""
CONTACT_ADDRESS="Rua Mariana Najar, 700 — Vila Nova Socorro, Mogi das Cruzes/SP"
CONTACT_ADDRESS_ZIP="CEP 08790-610"
OFFICE_HOURS="Atendimento mediante agendamento"

# Painel interno (/admin). Em produção, use senha forte e chave longa.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""
ADMIN_PASSWORD_HASH=""
ADMIN_SESSION_SECRET=""
ADMIN_SESSION_TTL_SECONDS="28800"

# WhatsApp oficial. Enquanto WHATSAPP_DRY_RUN=1, o painel registra sem enviar mensagens reais.
WHATSAPP_PROVIDER="official"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_APP_SECRET=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_FIRST_CONTACT_TEMPLATE=""
WHATSAPP_TEMPLATE_LANGUAGE="pt_BR"
WHATSAPP_AUTO_REPLY="1"
WHATSAPP_AUTO_REPLY_COOLDOWN_SECONDS="21600"

# Alternativa por QR do WhatsApp Web. O painel /admin exibe o QR quando o bridge estiver ativo.
# Em produção use uma URL privada do bridge e o mesmo token nos dois serviços.
WHATSAPP_QR_BRIDGE_URL="http://127.0.0.1:3333"
WHATSAPP_QR_BRIDGE_TOKEN="troque-por-uma-chave-longa"
WHATSAPP_QR_BRIDGE_AUTOSTART="1"
WHATSAPP_DRY_RUN="1"
# Valor local de exemplo; confirme a versão vigente na documentação da Meta antes da produção.
META_GRAPH_VERSION="v19.0"

# Used to hash visitor IPs for metrics without storing raw IP.
METRICS_SALT="change-me-local"
ANALYTICS_RETENTION_DAYS="180"
AUTH_EVENT_RETENTION_DAYS="365"
LEAD_RETENTION_DAYS="730"
